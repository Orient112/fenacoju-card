# Frontend (Vercel)
# En production, pointer vers l'API Render (évite le timeout 30s de Vercel pendant le paiement)
VITE_API_URL=http://localhost:3001

# Backend (Render / Railway / local)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://fenacoju-card.vercel.app

# Supabase
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key
SUPABASE_STORAGE_BUCKET=fenacoju-uploads

# SimplyPaye (paiement inscriptions compétition — Mobile Money)
# merchantCode + clé API DOIVENT appartenir au même compte (jamais côté frontend)
# Une mauvaise paire → 401 « Clé API marchand invalide »
SIMPLY_PAY_MERCHANT_CODE=votre_short_code
SIMPLY_PAY_API_KEY=votre_cle_api
